{
  "name": "analog-terminal-portfolio",
  "version": "3.5.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit 2>/dev/null || true",
    "clean": "rm -rf .next out",
    "clean:storage": "rm -rf data/storage",
    "prod": "npm run clean && npm run build && npm run start"
  },
  "dependencies": {
    "framer-motion": "^11.2.0",
    "geoip-lite": "^2.0.3",
    "gsap": "^3.12.5",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
