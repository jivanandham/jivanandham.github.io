# ─── Admin Access Control ───────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values before deploying.

# Admin password for blog publishing console (CHANGE THIS in production)
ADMIN_PASSWORD=your-strong-password-here

# Secret key for signing admin session tokens (CHANGE THIS in production)
# Generate with: openssl rand -hex 32
TOKEN_SECRET=your-64-char-hex-secret-here

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=production
